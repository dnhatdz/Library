        end
        Window:OnThemeChange(function(th)
            HeroCard.BackgroundColor3 = th.CardBg
            HeroStroke.Color = th.Stroke
            HeroStroke.Transparency = th.StrokeTrans
        end)
        return Tab
    end
    return Window
end
